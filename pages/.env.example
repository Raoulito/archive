# Where the pages find the desk. Empty = the archive's desk on workers.dev, called directly (the default).
# "/api" = same-origin, through a reverse proxy on the web server (see tools/Caddyfile.example) or Vite's dev proxy.
VITE_DESK=

# Deploy target for `npm run deploy` (put these in .env.local, which git ignores) (rsync over ssh with the deploy key)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/var/www/ubikistan.org
DEPLOY_KEY=~/UBIK_PILLED/deploy/ubikistan_deploy
